<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne part en sauvegarde ni vers un autre appareil : la base est
     chiffrée sous une clé du Keystore, qui ne voyage pas avec elle. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
