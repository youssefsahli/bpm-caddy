# Rust
/target
**/*.rs.bk

# Local data — never commit patient databases or keys
*.db
*.db-journal
*.sqlite
config.toml
*.key

# Generated documents
*.pdf
# …except the official Assurance Maladie bulletins d'adhésion, which are
# source assets: `include_bytes!` compiles them into the binary, so the
# build fails without them.
!assets/bulletins/*.pdf

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
# Personal working notes, not part of the published project.
ROADMAP.md
